// =========================================================
// FIRESTORE XAVFSIZLIK QOIDALARI (Security Rules)
// =========================================================
// O'RNATISH: Firebase Console > Firestore Database > Rules
// bo'limiga ushbu faylning to'liq matnini nusxalab, "Publish"
// tugmasini bosing.
//
// MANTIQ:
// - Har bir foydalanuvchi "users/{uid}" hujjatida o'z rolini saqlaydi
// - Admin - hamma narsaga to'liq kirish huquqiga ega
// - Teacher - faqat o'zining guruhlariga tegishli ma'lumotlarni
//   o'zgartira oladi (talabalarning umumiy profilini emas)
// - Student/Parent - faqat o'ziga (yoki farzandiga) tegishli
//   ma'lumotlarni o'qiy oladi, lekin akademik ma'lumotlarni
//   TAHRIRLAY OLMAYDI
// =========================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Yordamchi funksiyalar ----
    function isSignedIn() {
      return request.auth != null;
    }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }
    function isTeacher() {
      return isSignedIn() && getRole() == 'teacher';
    }
    function isStudent() {
      return isSignedIn() && getRole() == 'student';
    }
    function isParent() {
      return isSignedIn() && getRole() == 'parent';
    }
    // Talaba hujjati o'ziniki ekanini tekshiradi
    function isOwnStudentDoc(studentId) {
      return isSignedIn() && request.auth.uid == studentId;
    }
    // Ota-ona shu talabaning ota-onasi ekanini tekshiradi
    function isParentOf(studentId) {
      return isParent() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childId == studentId;
    }

    // ---- users: har bir foydalanuvchining roli va profili ----
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin(); // Faqat admin foydalanuvchi rolini o'zgartira oladi
    }

    // ---- students: talabalar profili ----
    match /students/{studentId} {
      allow read: if isAdmin() || isTeacher() ||
                     isOwnStudentDoc(studentId) || isParentOf(studentId);
      allow create, update, delete: if isAdmin(); // Talaba/ota-ona akademik ma'lumotni tahrirlay olmaydi
    }

    // ---- teachers, parents: admin to'liq boshqaradi ----
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /parents/{parentId} {
      allow read: if isAdmin() || isSignedIn() && request.auth.uid == parentId;
      allow write: if isAdmin();
    }

    // ---- groups, courses: admin yaratadi, hamma o'qiy oladi ----
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- attendance: o'qituvchi belgilaydi, tegishlilar o'qiydi ----
    match /attendance/{recordId} {
      allow read: if isAdmin() || isTeacher() ||
                     isOwnStudentDoc(resource.data.studentId) ||
                     isParentOf(resource.data.studentId);
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // ---- homework: o'qituvchi beradi, talaba/ota-ona o'qiydi ----
    match /homework/{hwId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isTeacher();
    }
    // Talabaning topshirgan javoblari
    match /homeworkSubmissions/{subId} {
      allow read: if isAdmin() || isTeacher() ||
                     isOwnStudentDoc(resource.data.studentId) ||
                     isParentOf(resource.data.studentId);
      allow create: if isStudent(); // Faqat talaba o'z javobini yuklay oladi
      allow update: if isAdmin() || isTeacher(); // Faqat o'qituvchi baholaydi
    }

    // ---- tests / exams / scores ----
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }
    match /scores/{scoreId} {
      allow read: if isAdmin() || isTeacher() ||
                     isOwnStudentDoc(resource.data.studentId) ||
                     isParentOf(resource.data.studentId);
      allow write: if isAdmin() || isTeacher(); // Talaba/ota-ona balni o'zgartira olmaydi
    }

    // ---- comments: o'qituvchi yozadi, talaba/ota-ona o'qiydi ----
    match /comments/{commentId} {
      allow read: if isAdmin() || isTeacher() ||
                     isOwnStudentDoc(resource.data.studentId) ||
                     isParentOf(resource.data.studentId);
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    // ---- payments: faqat admin yozadi, tegishlilar o'qiydi ----
    match /payments/{paymentId} {
      allow read: if isAdmin() ||
                     isOwnStudentDoc(resource.data.studentId) ||
                     isParentOf(resource.data.studentId);
      allow write: if isAdmin();
    }

    // ---- notifications ----
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin();
    }
  }
}
